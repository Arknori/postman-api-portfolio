{
  "info": {
    "name": "Suporte N1 - Portfolio API",
    "description": "Collection de estudo/portfólio para vaga de Suporte N1. Contém exemplos de GET, POST, PUT e DELETE usando APIs públicas gratuitas (JSONPlaceholder e ViaCEP).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ],
  "item": [
    {
      "name": "1 - GET - Buscar posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/posts/1",
          "host": ["{{base_url}}"],
          "path": ["posts", "1"]
        },
        "description": "Busca um post específico pelo ID. Espera-se status 200 e um JSON com os campos userId, id, title e body."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Resposta contém o campo title\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('title');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2 - POST - Criar post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Chamado de suporte N1\",\n  \"body\": \"Descrição do problema relatado pelo cliente\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts",
          "host": ["{{base_url}}"],
          "path": ["posts"]
        },
        "description": "Cria um novo recurso (simulação de abertura de chamado). Espera-se status 201 (Created)."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 201 (criado)\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3 - PUT - Atualizar post",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Chamado atualizado - resolvido\",\n  \"body\": \"Problema resolvido após reinício do serviço\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts/1",
          "host": ["{{base_url}}"],
          "path": ["posts", "1"]
        },
        "description": "Atualiza um recurso existente (simulação de atualização de status de chamado). Espera-se status 200."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4 - DELETE - Remover post",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/posts/1",
          "host": ["{{base_url}}"],
          "path": ["posts", "1"]
        },
        "description": "Remove um recurso (simulação de encerramento/exclusão de chamado). Espera-se status 200."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5 - BONUS - GET CEP (ViaCEP)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://viacep.com.br/ws/01001000/json/",
          "protocol": "https",
          "host": ["viacep", "com", "br"],
          "path": ["ws", "01001000", "json", ""]
        },
        "description": "API pública brasileira de consulta de CEP. Útil para mostrar familiaridade com APIs nacionais. Espera-se status 200 e um JSON com logradouro, bairro, localidade e uf."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Resposta contém o campo localidade\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('localidade');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
